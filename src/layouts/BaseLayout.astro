---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Northstar Studio | Build with clarity',
  description = 'A modern company website starter built with Astro and Tailwind CSS.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f766e" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
