---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  ['Strategy', 'Clear positioning and a practical roadmap that turns a good idea into focused action.'],
  ['Design', 'Thoughtful, responsive experiences that make your company feel credible at first glance.'],
  ['Delivery', 'Lean, reliable websites and digital systems your team can confidently maintain.'],
];

const projects = [
  ['Harbour Health', 'Brand strategy · Website', 'Helping a growing clinic make booking feel effortless.'],
  ['Luma Living', 'E-commerce · Content', 'A calm digital home for a considered interiors brand.'],
  ['Tandem Works', 'Identity · Platform', 'A sharper story for a specialist professional-services firm.'],
];
---

<BaseLayout>
  <Header />
  <main>
    <section class="relative overflow-hidden bg-mist pt-32">
      <div class="absolute -right-24 top-20 size-96 rounded-full bg-teal-200/50 blur-3xl"></div>
      <div class="mx-auto grid max-w-6xl gap-16 px-6 pb-24 pt-16 lg:grid-cols-[1.15fr_.85fr] lg:px-8 lg:pb-32">
        <div class="relative">
          <p class="mb-6 inline-flex rounded-full border border-teal-200 bg-white px-4 py-2 text-sm font-semibold text-brand">Independent digital studio</p>
          <h1 class="max-w-3xl text-5xl font-bold tracking-[-0.05em] text-ink sm:text-6xl lg:text-7xl">Build a business people <span class="text-brand">remember.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-8 text-slate">We help ambitious teams turn complex ideas into clear brands, useful websites, and momentum that lasts.</p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a class="rounded-full bg-brand px-6 py-3.5 font-semibold text-white transition hover:bg-brand-dark" href="#contact">Tell us about your project</a>
            <a class="rounded-full border border-slate-300 bg-white px-6 py-3.5 font-semibold text-ink transition hover:border-brand hover:text-brand" href="#work">Explore our work</a>
          </div>
          <div class="mt-14 flex gap-8 border-t border-slate-200 pt-7 text-sm"><div><strong class="block text-2xl text-ink">32+</strong>teams supported</div><div><strong class="block text-2xl text-ink">6 years</strong>of focused work</div></div>
        </div>
        <div class="relative self-center rounded-[2rem] bg-ink p-7 text-white shadow-2xl shadow-slate-400/30 sm:p-10">
          <div class="mb-20 flex items-center justify-between"><span class="text-sm font-semibold text-teal-200">Our point of view</span><span class="size-3 rounded-full bg-sun"></span></div>
          <p class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">“The clearest businesses are often the easiest to choose.”</p>
          <div class="mt-12 flex items-center gap-3 border-t border-slate-600 pt-6"><span class="grid size-10 place-items-center rounded-full bg-teal-700 font-bold">NS</span><span class="text-sm text-slate-300">Clarity is our favourite growth tool.</span></div>
        </div>
      </div>
    </section>

    <section id="services" class="mx-auto max-w-6xl px-6 py-24 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">What we do</p>
      <div class="mt-5 flex flex-col justify-between gap-8 md:flex-row"><h2 class="max-w-2xl text-4xl font-bold tracking-tight text-ink sm:text-5xl">The practical creative partner your team has been missing.</h2><p class="max-w-sm leading-7 text-slate">We bring senior thinking and hands-on delivery to the moments where getting it right matters most.</p></div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-slate-200 md:grid-cols-3">
        {services.map(([title, copy], i) => <article class="bg-white p-8"><span class="text-sm font-bold text-brand">0{i + 1}</span><h3 class="mt-12 text-2xl font-bold text-ink">{title}</h3><p class="mt-4 leading-7 text-slate">{copy}</p><a class="mt-8 inline-block font-semibold text-brand hover:text-brand-dark" href="#contact">Learn more →</a></article>)}
      </div>
    </section>

    <section id="approach" class="bg-ink py-24 text-white"><div class="mx-auto max-w-6xl px-6 lg:px-8"><div class="grid gap-10 lg:grid-cols-2"><div><p class="text-sm font-bold uppercase tracking-[0.18em] text-teal-200">How we work</p><h2 class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl">Less noise. More progress.</h2></div><p class="max-w-lg text-lg leading-8 text-slate-300">You get one small, senior team that learns your context quickly, tells you the truth, and makes steady progress visible.</p></div><ol class="mt-16 grid gap-8 md:grid-cols-3"><li><span class="text-5xl font-bold text-teal-300">01</span><h3 class="mt-6 text-xl font-bold">Find the signal</h3><p class="mt-3 leading-7 text-slate-300">We listen, challenge assumptions, and agree on the most valuable problem to solve.</p></li><li><span class="text-5xl font-bold text-teal-300">02</span><h3 class="mt-6 text-xl font-bold">Make it tangible</h3><p class="mt-3 leading-7 text-slate-300">We shape the story, experience, and system together before investing in the details.</p></li><li><span class="text-5xl font-bold text-teal-300">03</span><h3 class="mt-6 text-xl font-bold">Ship and learn</h3><p class="mt-3 leading-7 text-slate-300">We launch with care, equip your team, and improve from real-world feedback.</p></li></ol></div></section>

    <section id="work" class="bg-mist py-24"><div class="mx-auto max-w-6xl px-6 lg:px-8"><p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Selected work</p><div class="mt-5 flex flex-wrap items-end justify-between gap-6"><h2 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">A few good things<br />we've helped make real.</h2><a class="font-semibold text-brand hover:text-brand-dark" href="#contact">View all projects →</a></div><div class="mt-14 grid gap-6 md:grid-cols-3">{projects.map(([name, type, copy], i) => <article class="group overflow-hidden rounded-2xl bg-white shadow-sm"><div class:list={['h-52 p-6 transition duration-300 group-hover:scale-[1.03]', i === 0 && 'bg-teal-700', i === 1 && 'bg-amber-200', i === 2 && 'bg-sky-200']}><span class="rounded-full bg-white/80 px-3 py-1 text-xs font-bold text-ink">{type}</span></div><div class="p-6"><h3 class="text-xl font-bold text-ink">{name}</h3><p class="mt-3 leading-7 text-slate">{copy}</p></div></article>)}</div></div></section>

    <section id="contact" class="mx-auto max-w-6xl px-6 py-24 lg:px-8"><div class="rounded-3xl bg-brand px-7 py-14 text-white sm:px-14 sm:py-20"><p class="text-sm font-bold uppercase tracking-[0.18em] text-teal-100">Start a conversation</p><div class="mt-5 grid gap-10 lg:grid-cols-[1.3fr_.7fr] lg:items-end"><div><h2 class="text-4xl font-bold tracking-tight sm:text-5xl">Have a meaningful problem to solve?</h2><p class="mt-5 max-w-xl text-lg leading-8 text-teal-50">Tell us where you want to go. We’ll reply within two working days with a useful next step.</p></div><div><a class="block rounded-full bg-white px-6 py-4 text-center font-bold text-brand transition hover:bg-teal-50" href="mailto:hello@northstarstudio.com?subject=Project%20enquiry">hello@northstarstudio.com</a><p class="mt-4 text-center text-sm text-teal-100">Replace this email address with yours.</p></div></div></div></section>
  </main>
  <Footer />
</BaseLayout>
